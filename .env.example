# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_TARGET_CHANNEL=
TELEGRAM_SOURCE_CHANNELS=

# Garimpo: páginas públicas separadas por vírgula
DEAL_SOURCE_URLS=

# Frequência: padrão a cada 10 minutos
SCAN_CRON=*/10 * * * *

# Afiliados
AMAZON_TAG=ofertaradar03-20

# KaBuM/Awin - preencher somente após confirmar o formato oficial do deeplink
KABUM_AWIN_TEMPLATE=

# Magalu - preencher somente após confirmar o formato oficial do deeplink
MAGALU_AFFILIATE_TEMPLATE=

# Shopee - usar o formato oficial/gerado pela sua conta de afiliado
SHOPEE_AFFILIATE_TEMPLATE=

# Mercado Livre - usar o formato oficial/gerado pela sua conta de afiliado
MERCADOLIVRE_AFFILIATE_TEMPLATE=

# WhatsApp ficará como adaptador separado
WHATSAPP_ENABLED=false
