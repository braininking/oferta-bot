[Unit]
Description=Oferta Bot - garimpo e publicação de ofertas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ofertabot
WorkingDirectory=/opt/ofertabot
ExecStart=/usr/bin/node /opt/ofertabot/src/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
